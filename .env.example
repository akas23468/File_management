# GEMINI_API_KEY: Google Gemini API key for server-side AI reasoning & document summarization
GEMINI_API_KEY=""

# SUPABASE_URL: Project URL from Supabase dashboard
SUPABASE_URL=""

# SUPABASE_PUBLISHABLE_KEY: Anon / Publishable key for Supabase client
SUPABASE_PUBLISHABLE_KEY=""

# XAI_API_KEY: Required for xAI Grok API calls (https://api.x.ai/v1/chat/completions).
XAI_API_KEY="MY_XAI_API_KEY"

# GROK_MODEL: Grok model identifier (e.g. grok-4, grok-2-latest, grok-beta)
GROK_MODEL="grok-4"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
